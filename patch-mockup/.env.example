# Copy to .env and fill in real values. Never commit the real .env.

# --- Auth between the CRM and this service (CLAUDE.md §2 rule 3) ---
# openssl rand -hex 32  (run twice, once per key)
DIGITIZE_API_KEY=
# CRM sends this as `Authorization: Bearer <DIGITIZE_API_KEY>` to POST /mockup/jobs
DIGITIZE_CALLBACK_SECRET=
# this service sends this as `Authorization: Bearer <DIGITIZE_CALLBACK_SECRET>`
# to the CRM's mockup-callback Edge Function

# --- Optional: fal.ai FLUX finishing pass (CLAUDE.md §9) ---
# FAL_KEY=

# --- CORS: comma-separated list of allowed origins ---
ALLOWED_ORIGINS=https://pandapatches.com,https://www.pandapatches.com

# --- Upload cap in bytes; default 15MB ---
# MAX_UPLOAD_BYTES=15728640

# REDIS_URL is set directly in docker-compose.yml (points at the redis
# service) — no need to set it here for the VPS deploy.
